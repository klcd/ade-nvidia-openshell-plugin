{
  "manifestVersion": 2,
  "id": "openshell-bridge",
  "name": "OpenShell Bridge",
  "version": "0.3.0",
  "description": "Route Orca agent launches through OpenShell sandboxes, inspect allowed Landlock/network/CLI command policies, and bind restricted orchestration delegation.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "hooks": [
      { "event": "agent.launch.before", "onError": "deny" }
    ],
    "panels": [
      {
        "id": "policies",
        "title": "OpenShell Policies",
        "icon": "layers",
        "entry": "panel/index.html"
      }
    ],
    "commands": [
      {
        "id": "openshell.inspectPolicies",
        "title": "OpenShell: Inspect Allowed Policies & CLI Commands"
      }
    ],
    "statusBarItems": [
      {
        "id": "openshell-status",
        "text": "OpenShell: Off (Host Mode)",
        "icon": "layers",
        "tone": "warning",
        "tooltip": "OpenShell Sandbox & CLI Command Policies (click to inspect)",
        "command": "openshell.inspectPolicies"
      }
    ]
  },
  "capabilities": []
}
