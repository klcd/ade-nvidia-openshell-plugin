{
  "name": "@orca/openshell-bridge",
  "version": "1.0.0",
  "description": "ADE NVIDIA OpenShell Plugin — High-performance TypeScript bridge between Orca, agent CLIs (Claude Code, Antigravity, Codex), and NVIDIA OpenShell Landlock sandboxes",
  "repository": {
    "type": "git",
    "url": "https://github.com/klcd/ade-nvidia-openshell-plugin.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-box": "dist/cli.js",
    "claude-box": "dist/cli.js",
    "codex-box": "dist/cli.js",
    "agy-box": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "bun build src/cli.ts --outfile=dist/agent-box.bundle.js --target=node",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "orca",
    "openshell",
    "sandbox",
    "landlock",
    "codex",
    "claude-code",
    "antigravity"
  ],
  "author": "Google DeepMind / Cedric",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
